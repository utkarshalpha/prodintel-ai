# ---------------------------------------------------------------------------
# ProdIntel AI — .gitignore (Python, production-grade)
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Environment / secrets
.env
.env.*
!.env.example

# Local databases (SQLite used by the dev/test default)
*.db
*.sqlite
*.sqlite3
prodintel.db
offline_check.db

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# IDE / editor — VS Code
.vscode/
*.code-workspace

# IDE / editor — JetBrains
.idea/

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
